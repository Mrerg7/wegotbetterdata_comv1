---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  HERO_IMAGE_CDN,
  SITE,
  BUY_MAILTO,
  OFFER_MAILTO,
  ACQUISITION_MAILTO,
  TRUST_SIGNALS,
  TESTIMONIALS,
  RECENT_SALES,
} from '../consts';
---

<BaseLayout>
  <!-- HERO -->
  <section data-hero class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden hero-bg data-grid-bg">
    <div class="absolute inset-0 z-0">
      <img
        src={HERO_IMAGE_CDN}
        alt="WeGotBetterData.com premium domain visualization"
        width="1920"
        height="1080"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-[#050914]/85 via-[#050914]/60 to-[#050914]/95"></div>
      <div class="absolute inset-0 bg-[radial-gradient(#38bdf8_0.6px,transparent_1px)] bg-[length:6px_6px] opacity-[0.06]"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-24 pb-28">
      <div class="inline-flex items-center gap-x-2 px-4 py-2 rounded-full border border-sky-400/30 bg-sky-400/5 mb-6 min-h-10">
        <div class="w-2 h-2 bg-sky-400 rounded-full data-pulse" aria-hidden="true"></div>
        <span class="uppercase tracking-[3px] text-xs text-sky-300">Premium .com · Available for acquisition</span>
      </div>

      <p class="font-display text-sky-300/90 text-sm sm:text-base tracking-[4px] uppercase mb-4">
        Domain marketplace listing
      </p>

      <h1 class="text-[42px] sm:text-[56px] md:text-[80px] leading-[0.95] font-display font-bold tracking-tighter mb-4 text-balance text-white">
        WeGotBetterData.com
      </h1>

      <p class="text-xl md:text-2xl font-display font-semibold text-white/90 mb-3">
        We Got <span class="data-gradient">Better Data.</span>
      </p>

      <p class="max-w-2xl mx-auto mb-8 text-lg md:text-xl text-slate-300 font-light leading-relaxed">
        Category-owning premium domain for AI data quality — priced at
        <span class="text-white font-semibold">{SITE.priceDisplay}</span>, escrow-ready, and built for strategic buyers.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-8 text-sm text-slate-300">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 min-h-10">
          Asking <strong class="text-sky-300">{SITE.priceDisplay}</strong>
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/30 bg-amber-400/10 px-4 py-2 min-h-10 text-amber-200">
          <span class="w-2 h-2 rounded-full bg-amber-400" aria-hidden="true"></span>
          1 premium asset remaining
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 min-h-10">
          <span data-view-count>12</span> people viewing
        </span>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
        <a href={BUY_MAILTO} class="btn-accent" data-track="hero-buy">
          Buy Now
          <span class="text-xl" aria-hidden="true">↗</span>
        </a>
        <a href="/offer/" class="btn-outline !text-sky-200" data-track="hero-offer">Make Offer</a>
        <a href={ACQUISITION_MAILTO} class="btn-outline !text-sky-200" data-track="hero-agent">Contact Agent</a>
      </div>

      <ul class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto" aria-label="Trust signals">
        {TRUST_SIGNALS.map((item) => (
          <li class="rounded-2xl border border-white/10 bg-black/30 px-4 py-3 text-left min-w-[140px]">
            <p class="text-sm font-semibold text-white">{item.label}</p>
            <p class="text-xs text-slate-400">{item.detail}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-y-1 text-xs tracking-[3px] text-white/30">
      <span>THE INDEX THE MARKET WILL CONSULT</span>
      <div class="w-px h-8 bg-gradient-to-b from-transparent via-sky-400/40 to-transparent"></div>
    </div>
  </section>

  <!-- SOCIAL PROOF STRIP -->
  <section class="section-bg border-y border-[var(--border)] py-10" aria-label="Market comps and social proof">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] items-center">
        <div>
          <p class="uppercase tracking-[3px] text-xs text-sky-400 mb-2 font-semibold">Recent category sales</p>
          <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight">Industry recognition for premium names</h2>
        </div>
        <ul class="grid sm:grid-cols-3 gap-4">
          {RECENT_SALES.map((sale) => (
            <li class="card-surface p-4">
              <p class="font-display font-semibold text-sky-400">{sale.domain}</p>
              <p class="text-sm text-[var(--muted)] mt-1">{sale.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem" class="section-bg py-24">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="grid md:grid-cols-12 gap-x-12 items-start">
        <div class="md:col-span-5">
          <div class="sticky top-28">
            <div class="uppercase tracking-[3px] text-xs text-sky-400 mb-3 font-semibold">The Landscape</div>
            <h2 class="text-4xl md:text-6xl font-display font-bold leading-none tracking-tight mb-6">
              AI Choice Overload<br />Meets Data<br /><span class="text-sky-400">Uncertainty</span>
            </h2>
            <div class="w-16 h-px bg-gradient-to-r from-sky-400 to-transparent mb-6"></div>
            <p class="text-lg text-[var(--muted)] leading-relaxed">
              Hundreds of AI models and providers compete for attention. Each claims superior intelligence, reasoning, or "real-time knowledge." Yet behind every response lies training data that vary dramatically in accuracy, freshness, bias, and transparency.
            </p>
          </div>
        </div>

        <div class="md:col-span-7 mt-12 md:mt-0 space-y-6">
          <div class="card-surface p-8 card-hover reveal">
            <h3 class="text-lg font-semibold mb-2">Hallucinations & Confident Fabrications</h3>
            <p class="text-[var(--muted)] leading-relaxed">AI models routinely generate plausible-sounding but factually incorrect information, eroding trust across every sector from healthcare to legal services.</p>
          </div>
          <div class="card-surface p-8 card-hover reveal">
            <h3 class="text-lg font-semibold mb-2">Opaque & Outdated Training Corpora</h3>
            <p class="text-[var(--muted)] leading-relaxed">Hidden training data sources and stale information create concealed risks that can surface as compliance violations, biased outputs, or catastrophic failures in production.</p>
          </div>
          <div class="card-surface p-8 card-hover reveal">
            <h3 class="text-lg font-semibold mb-2">Benchmark Gaming & Hype-Driven Decisions</h3>
            <p class="text-[var(--muted)] leading-relaxed">Marketing claims and cherry-picked benchmarks make objective comparison nearly impossible, forcing enterprises into high-stakes procurement decisions without a neutral, authoritative source.</p>
          </div>
          <div class="mt-8 p-6 bg-sky-400/5 border border-sky-400/20 rounded-2xl reveal">
            <p class="text-lg text-sky-200/90 italic font-light">
              "The market has moved past the 'which model is smartest?' phase. We are now entering the <span class="font-semibold text-[var(--fg)]">'whose data can I actually trust?'</span> era."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- OPPORTUNITY -->
  <section id="opportunity" class="py-24 hero-bg">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="text-center mb-16">
        <div class="uppercase tracking-[4px] text-xs text-sky-400 mb-4 font-semibold">Strategic Positioning</div>
        <h2 class="text-4xl md:text-6xl font-display font-bold leading-none tracking-tight mb-6">
          Own the Semantic<br /><span class="data-gradient">High Ground</span>
        </h2>
        <p class="max-w-2xl mx-auto text-xl text-[var(--muted)] leading-relaxed">
          wegotbetterdata.com is not just a memorable domain. It is a <span class="text-[var(--fg)] font-semibold">category-owning phrase</span> that directly addresses the core question every AI user and buyer is already asking.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          ['Instant Credibility', 'The name itself conveys authority and expertise in the AI data quality space before a single page is built.'],
          ['Clear Commercial Intent', '"Better data" = higher performance, lower risk. The value proposition is embedded in the domain itself.'],
          ['Strong Brand Voice', 'Confident, no-nonsense, superior. A brand voice that commands attention in a noisy marketplace.'],
          ['Exceptional Memorability', 'Short, punchy, impossible to forget. Built for word-of-mouth virality and organic brand recall.'],
        ].map(([title, body]) => (
          <div class="card-surface p-8 text-center card-hover reveal">
            <h3 class="text-lg font-semibold mb-3">{title}</h3>
            <p class="text-[var(--muted)] text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- PLATFORM -->
  <section id="platform" class="section-bg py-24">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="text-center mb-16">
        <div class="uppercase tracking-[4px] text-xs text-sky-400 mb-4 font-semibold">Platform Potential</div>
        <h2 class="text-4xl md:text-6xl font-display font-bold leading-none tracking-tight mb-6">
          What a Strategic<br /><span class="data-gradient">Buyer Can Build</span>
        </h2>
        <p class="max-w-2xl mx-auto text-xl text-[var(--muted)]">
          A powerful foundation for high-value platforms with multiple monetization paths.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          ['01', 'AI Data Quality Index & Leaderboards', 'Objective rankings on accuracy, factual grounding, data freshness, bias mitigation, and source transparency.'],
          ['02', 'Enterprise Procurement & Due Diligence', 'Decision frameworks, risk scoring, and vendor comparison reports for high-stakes procurement.'],
          ['03', 'Consumer & Developer Decision Engine', 'Trustworthy guidance for choosing AI tools based on real data performance rather than marketing hype.'],
          ['04', 'Data Trust Score API & Widgets', 'Embeddable widgets and API integrations that display verified data-quality signals.'],
          ['05', 'Premium Research, Reports & Newsletters', '"The State of AI Data Quality" reports and executive briefings — high-margin subscription revenue.'],
          ['06', 'Certification & Badging Program', '"Better Data Certified" seals for providers meeting rigorous, transparent standards.'],
        ].map(([num, title, body]) => (
          <div class="card-surface p-8 card-hover reveal">
            <div class="w-12 h-12 rounded-xl bg-sky-400/10 flex items-center justify-center mb-5">
              <span class="text-sky-400 text-2xl font-display font-bold">{num}</span>
            </div>
            <h3 class="text-xl font-semibold mb-3">{title}</h3>
            <p class="text-[var(--muted)] leading-relaxed text-sm">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- VALUE -->
  <section id="value" class="hero-bg py-24">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="text-center mb-16">
        <div class="uppercase tracking-[4px] text-xs text-sky-400 mb-4 font-semibold">Domain Valuation</div>
        <h2 class="text-4xl md:text-6xl font-display font-bold leading-none tracking-tight mb-6">
          Why This Domain Supports a<br /><span class="data-gradient">Premium Acquisition</span>
        </h2>
        <p class="max-w-2xl mx-auto text-xl text-[var(--muted)]">
          The AI market has already demonstrated extraordinary willingness to pay for category-defining digital assets.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          ['¹', 'Exact Commercial Relevance', 'It contains the precise language buyers use when evaluating AI solutions. "Who has better data?" is the question — this domain is the answer.'],
          ['²', 'Perfect Market Timing', 'The industry is shifting from capability hype to trust, accuracy, and data accountability. This domain owns that conversation.'],
          ['³', 'Brand + Keyword Strength', 'Short, confident, memorable, and keyword-rich on a premium .com — delivering both SEO power and brand authority.'],
        ].map(([num, title, body]) => (
          <div class="card-surface p-8 card-hover reveal">
            <div class="w-14 h-14 rounded-2xl bg-sky-400/10 flex items-center justify-center mb-6">
              <span class="text-sky-400 text-2xl font-display font-bold">{num}</span>
            </div>
            <h3 class="text-xl font-semibold mb-4">{title}</h3>
            <p class="text-[var(--muted)] leading-relaxed">{body}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={BUY_MAILTO} class="btn-accent" data-track="value-buy">Buy Now · {SITE.priceDisplay}</a>
        <a href={OFFER_MAILTO} class="btn-outline" data-track="value-offer">Make Offer</a>
        <a href="/insights/" class="btn-outline">Read valuation insights</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section-bg py-24 border-t border-[var(--border)]" aria-labelledby="proof-heading">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="text-center mb-12">
        <p class="uppercase tracking-[3px] text-xs text-sky-400 mb-3 font-semibold">Social proof</p>
        <h2 id="proof-heading" class="font-display text-3xl md:text-5xl font-bold tracking-tight">What buyers say about premium domains</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {TESTIMONIALS.map((t) => (
          <blockquote class="card-surface p-8 reveal">
            <p class="text-[var(--muted)] leading-relaxed mb-6">“{t.quote}”</p>
            <footer>
              <cite class="not-italic font-semibold text-[var(--fg)]">{t.name}</cite>
              <p class="text-sm text-[var(--muted)]">{t.role}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- INSIGHTS TEASER -->
  <section class="py-20 hero-bg">
    <div class="mx-auto max-w-screen-xl px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">Domain valuation guides & market trends</h2>
      <p class="text-[var(--muted)] max-w-2xl mx-auto mb-8 text-lg">
        Weekly insights on premium domain names, investment domains, and AI-category brandables — built to support serious acquisition decisions.
      </p>
      <a href="/insights/" class="btn-outline">Explore the insights blog</a>
    </div>
  </section>

  <script>
    const reveals = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      reveals.forEach((el) => io.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add('is-visible'));
    }

    // Lightweight CTA tracking hook (ready for analytics pixels)
    document.querySelectorAll('[data-track]').forEach((el) => {
      el.addEventListener('click', () => {
        const event = el.getAttribute('data-track');
        // @ts-expect-error optional analytics
        window.dataLayer = window.dataLayer || [];
        // @ts-expect-error optional analytics
        window.dataLayer.push({ event: 'cta_click', cta: event });
      });
    });
  </script>
</BaseLayout>
