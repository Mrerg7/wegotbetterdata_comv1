---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | WeGotBetterData`}
  description={post.data.description}
  type="article"
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: 'WeGotBetterData.com',
  }}
>
  <article class="pt-28 pb-20 section-bg">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-xs uppercase tracking-[2px] text-sky-400 mb-3">{post.data.category}</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight mb-4">{post.data.title}</h1>
      <p class="text-lg text-[var(--muted)] mb-6">{post.data.description}</p>
      <time class="text-sm text-[var(--muted)]" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>

      <div class="prose-domain mt-10 space-y-5 text-[var(--fg)]/90 leading-relaxed text-lg [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-3 [&_a]:text-sky-400 [&_a]:underline [&_strong]:text-[var(--fg)] [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6">
        <Content />
      </div>

      <div class="mt-12 flex flex-wrap gap-3 border-t border-[var(--border)] pt-8">
        <a href="/insights/" class="btn-outline !text-sm">All insights</a>
        <a href="/#acquire" class="btn-accent !text-sm !px-6">Acquire WeGotBetterData.com</a>
      </div>
    </div>
  </article>
</BaseLayout>
