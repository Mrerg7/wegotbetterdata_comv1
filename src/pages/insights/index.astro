---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('insights'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Domain Insights | Premium Domain Names & Market Trends | WeGotBetterData"
  description="Weekly guides on premium domain names, investment domains, valuation, and AI category brandables — from the WeGotBetterData.com listing team."
  showStickyBuy={true}
>
  <section class="pt-28 pb-16 section-bg">
    <div class="mx-auto max-w-screen-xl px-6">
      <p class="uppercase tracking-[3px] text-xs text-sky-400 mb-3 font-semibold">Content marketing</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold tracking-tight mb-4">Domain insights</h1>
      <p class="text-lg text-[var(--muted)] max-w-2xl mb-8">
        Valuation guides, market trends, and success stories for buyers evaluating premium .com domains and investment-grade brandables.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 max-w-xl mb-10">
        <label class="sr-only" for="insight-search">Search insights</label>
        <input
          id="insight-search"
          type="search"
          placeholder="Filter by keyword, TLD topic, valuation…"
          class="flex-1 min-h-12 rounded-2xl border border-[var(--border)] bg-[var(--bg)] px-4 text-base"
        />
      </div>

      <p id="insights-empty" class="hidden card-surface p-8 mb-6">
        <span class="block text-lg font-semibold mb-2">No matching articles</span>
        <span class="text-[var(--muted)]">Try a broader keyword or clear the filter.</span>
      </p>

      <ul id="insights-list" class="grid md:grid-cols-2 gap-6">
        {posts.map((post) => (
          <li
            class="insight-card card-surface p-8 card-hover"
            data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()}
          >
            <p class="text-xs uppercase tracking-[2px] text-sky-400 mb-2">{post.data.category}</p>
            <h2 class="font-display text-2xl font-bold mb-3">
              <a href={`/insights/${post.id}/`} class="hover:text-sky-400 transition-colors">
                {post.data.title}
              </a>
            </h2>
            <p class="text-[var(--muted)] mb-4">{post.data.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {post.data.tags.map((tag) => (
                <span class="text-[11px] px-2.5 py-1 rounded-full border border-[var(--border)] text-[var(--muted)]">{tag}</span>
              ))}
            </div>
            <time class="text-sm text-[var(--muted)]" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </li>
        ))}
      </ul>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href="/" class="btn-outline !text-sm">← Back to WeGotBetterData.com</a>
        <a href="/offer/" class="btn-accent !text-sm !px-6">Make an offer on the domain</a>
      </div>
    </div>
  </section>

  <script>
    const input = document.getElementById('insight-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.insight-card'));
    const empty = document.getElementById('insights-empty');

    const apply = () => {
      const q = (input?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const hay = card.dataset.search || '';
        const show = !q || hay.includes(q);
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      empty?.classList.toggle('hidden', visible > 0);
    };

    input?.addEventListener('input', apply);
  </script>
</BaseLayout>
