---
import { ACQUISITION_MAILTO, NAV_LINKS } from '../consts';
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <nav class="mx-auto max-w-screen-xl px-4 sm:px-6 h-20 flex items-center justify-between" aria-label="Primary">
    <a href="/" class="flex items-center gap-x-3 min-h-12" aria-label="WeGotBetterData.com home">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-400 to-cyan-500 flex items-center justify-center">
        <span class="text-[#050914] font-bold text-lg tracking-tighter">WD</span>
      </div>
      <div>
        <div class="font-semibold tracking-[2px] text-sm text-[var(--fg)]">WEGOTBETTERDATA</div>
        <div class="text-[10px] text-sky-500/70 -mt-1 tracking-wider">.COM</div>
      </div>
    </a>

    <div class="hidden lg:flex items-center gap-x-7 text-sm tracking-widest text-[var(--muted)]">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="hover:text-sky-400 transition-colors py-3">
          {link.label.toUpperCase()}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="tap-target inline-flex items-center justify-center rounded-xl border border-[var(--border)] text-[var(--muted)] hover:text-sky-400 hover:border-sky-400/50 transition-colors"
        aria-label="Toggle light and dark mode"
      >
        <svg class="theme-icon-dark w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="theme-icon-light w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a
        href={ACQUISITION_MAILTO}
        class="hidden md:inline-flex items-center gap-x-2 min-h-12 px-6 py-2.5 text-xs tracking-[2px] border border-sky-400/40 text-sky-400 hover:bg-sky-400/10 hover:border-sky-400 transition-all rounded-full font-semibold"
        data-track="nav-inquire"
      >
        INQUIRE
        <span class="text-base" aria-hidden="true">↗</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden tap-target inline-flex items-center justify-center rounded-xl border border-[var(--border)] text-sky-400"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="menu-icon-open w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="menu-icon-close w-6 h-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-[var(--border)] bg-[var(--bg-elevated)]">
    <div class="mx-auto max-w-screen-xl px-4 py-4 flex flex-col gap-1">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link min-h-12 flex items-center px-3 rounded-xl text-base text-[var(--fg)] hover:bg-sky-400/10 hover:text-sky-400 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/#acquire"
        class="mobile-nav-link mt-2 min-h-12 inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-sky-400 via-cyan-400 to-teal-400 px-4 text-base font-bold text-[#050914]"
      >
        Buy / Inquire
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.menu-icon-open');
  const closeIcon = btn?.querySelector('.menu-icon-close');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  };

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  menu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const themeBtn = document.getElementById('theme-toggle');
  const sun = themeBtn?.querySelector('.theme-icon-dark');
  const moon = themeBtn?.querySelector('.theme-icon-light');

  const applyThemeIcons = (theme: string) => {
    const isLight = theme === 'light';
    sun?.classList.toggle('hidden', isLight);
    moon?.classList.toggle('hidden', !isLight);
  };

  applyThemeIcons(document.documentElement.dataset.theme || 'dark');

  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('wgb-theme', next);
    applyThemeIcons(next);
  });
</script>
