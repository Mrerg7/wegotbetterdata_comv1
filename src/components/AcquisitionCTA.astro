---
import { ACQUISITION_MAILTO } from '../consts';

interface Props {
  label?: string;
  variant?: 'primary' | 'accent' | 'outline';
  class?: string;
  href?: string;
  track?: string;
}

const {
  label = 'Request acquisition terms',
  variant = 'accent',
  class: extraClass = '',
  href = ACQUISITION_MAILTO,
  track = 'cta-inquire',
} = Astro.props;

const variantClasses: Record<string, string> = {
  primary: 'btn-primary',
  accent: 'btn-accent',
  outline: 'btn-outline',
};
---

<a
  href={href}
  class={`${variantClasses[variant]} ${extraClass}`}
  data-track={track}
>
  {label}
</a>
