---
import { BUY_MAILTO, SITE } from '../consts';
---

<div
  id="sticky-buy-bar"
  class="fixed bottom-0 inset-x-0 z-40 translate-y-full transition-transform duration-300 border-t border-[var(--border)] bg-[var(--bg-elevated)]/95 backdrop-blur-xl"
  role="region"
  aria-label="Quick purchase"
>
  <div class="mx-auto max-w-screen-xl px-4 py-3 flex flex-wrap items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="font-display text-base sm:text-lg font-semibold truncate">{SITE.name}</p>
      <p class="text-sm text-[var(--muted)]">
        Asking <span class="text-sky-400 font-semibold">{SITE.priceDisplay}</span>
        · <span data-view-count>12</span> viewing now
      </p>
    </div>
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <a href="/#acquire" class="btn-outline flex-1 sm:flex-none !px-5 !py-3 !text-sm min-h-12">Make Offer</a>
      <a href={BUY_MAILTO} class="btn-accent flex-1 sm:flex-none !px-5 !py-3 !text-sm min-h-12" data-track="sticky-buy">Buy Now</a>
    </div>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-buy-bar');
  const hero = document.querySelector('[data-hero]');
  if (bar && hero && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle('translate-y-full', entry.isIntersecting);
        bar.classList.toggle('translate-y-0', !entry.isIntersecting);
      },
      { threshold: 0.15 },
    );
    io.observe(hero);
  }
</script>
